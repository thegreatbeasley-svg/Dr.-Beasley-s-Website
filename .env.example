# Copy this file to .env.local and adjust as needed.
# .env.local is gitignored and never committed.

# --- Local demo admin login (NOT production authentication) ---
# Plain-text env credentials are only acceptable for this local demo.
# See README.md "Production work remaining" before shipping this anywhere real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=beasly-demo-2026

# Public site URL used to build absolute links (download confirmations, etc.)
# Keep this pointed at localhost for the demo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production Supabase (leave unset to keep using the local SQLite demo) ---
# Find these in Supabase > Project Settings > API. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email address of the Supabase Auth user allowed into /admin.
ADMIN_EMAIL=
